# ==============================================================================
# STUDENT ENROLLMENT AND FACULTY MANAGEMENT SYSTEM
# Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Public Variables (Accessible in the browser - safe to expose)
# ------------------------------------------------------------------------------
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable Key (New Supabase standard replacing legacy anon key, client-safe, protected by RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile Site Key (Public widget key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ------------------------------------------------------------------------------
# Server-Only Privileged Secrets (NEVER expose to browser / client bundles!)
# ------------------------------------------------------------------------------
# Supabase Secret Key (New Supabase standard replacing legacy service_role key - strictly server-only)
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Cloudflare Turnstile Secret Key (Server-side token verification)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
