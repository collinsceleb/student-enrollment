# ==============================================================================
# STUDENT ENROLLMENT AND FACULTY MANAGEMENT SYSTEM
# Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Public Variables (Accessible in the browser - safe to expose)
# ------------------------------------------------------------------------------
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (Client-safe, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile Site Key (Public widget key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ------------------------------------------------------------------------------
# Server-Only Privileged Secrets (NEVER expose to browser / client bundles!)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS - strictly for server-side admin ops)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare Turnstile Secret Key (Server-side token verification)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
